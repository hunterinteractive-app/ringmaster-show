  "functions": [
    {
      "proname": "user_can_manage_show_lineup",
      "args": "p_show_id uuid",
      "definition": "CREATE OR REPLACE FUNCTION public.user_can_manage_show_lineup(p_show_id uuid)\n RETURNS boolean\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$ select exists (select 1 from public.role_assignments ra where ra.show_id = p_show_id and ra.user_id = auth.uid() and ra.role in ('admin', 'superintendent')) or exists (select 1 from public.role_assignments ra where ra.user_id = auth.uid() and ra.role = 'super_admin') or exists (select 1 from public.super_admins sa where sa.user_id = auth.uid()); $function$\n"
    }
  ]
