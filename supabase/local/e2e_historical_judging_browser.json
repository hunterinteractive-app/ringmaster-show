  "functions": [
    {
      "proname": "record_judging_session_entry",
      "arguments": "p_show_id uuid, p_judge_id uuid, p_entry_id uuid, p_table_number text",
      "definition": "CREATE OR REPLACE FUNCTION public.record_judging_session_entry(p_show_id uuid, p_judge_id uuid, p_entry_id uuid, p_table_number text DEFAULT NULL::text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n  v_session_id uuid;\n  v_entries int;\n  v_started_at timestamptz;\n  v_ended_at timestamptz;\nbegin\n  select id\n  into v_session_id\n  from public.judge_judging_sessions\n  where show_id = p_show_id\n    and judge_id = p_judge_id\n    and ended_at is null\n  order by started_at desc\n  limit 1;\n\n  if v_session_id is null then\n    insert into public.judge_judging_sessions (\n      show_id,\n      judge_id,\n      table_number,\n      started_at,\n      entries_judged\n    )\n    values (\n      p_show_id,\n      p_judge_id,\n      p_table_number,\n      now(),\n      1\n    );\n    return;\n  end if;\n\n  update public.judge_judging_sessions\n  set\n    entries_judged = entries_judged + 1,\n    updated_at = now()\n  where id = v_session_id;\n\n  select entries_judged, started_at, updated_at\n  into v_entries, v_started_at, v_ended_at\n  from public.judge_judging_sessions\n  where id = v_session_id;\n\n  update public.judge_judging_sessions\n  set calculated_entries_per_hour =\n    case\n      when extract(epoch from (v_ended_at - v_started_at)) > 0 then\n        v_entries / (extract(epoch from (v_ended_at - v_started_at)) / 3600.0)\n      else null\n    end\n  where id = v_session_id;\nend;\n$function$\n"
    }
  ]
