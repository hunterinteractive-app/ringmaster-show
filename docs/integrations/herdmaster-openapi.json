  "webhooks": {
    "animalRefreshRequested": {
      "post": {
        "summary": "RingMaster requests an animal refresh from HerdMaster",
        "description": "Staged contract for Joe to implement at an agreed HTTPS endpoint hosted by HerdMaster. This is not a route under the RingMaster API base URL. RingMaster calls it only after an authenticated, authorized user clicks Refresh linked animals. Verify the separate callback secret, resolve the stored connection/account pairing, and deduplicate request_id. Renew the connection credentials only if needed, with serialized rotation and atomic replacement storage. Push active animals and necessary inactive updates through RingMaster POST /v1/animals in batches up to 500, attaching refresh_request_id and refresh_complete=false until the final batch. The final batch uses true; an empty final batch is allowed. Return HTTP 200 only after RingMaster has accepted the final batch. Complete delivery within 40 seconds; the callback has a 45-second timeout and requests expire after two minutes. If this cannot be met, agree an asynchronous extension before implementation. Do not enqueue work and immediately report success. RingMaster checks committed completion independently. No periodic background animal polling is required. Do not receive or store RingMaster passwords or session JWTs.",
        "security": [
          {
            "RefreshCallbackSecret": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnimalRefreshCallback"
              },
              "example": {
                "request_id": "00000000-0000-4000-8000-000000000001",
                "connection_id": "00000000-0000-4000-8000-000000000002",
                "herdmaster_account_id": "HM-account-789"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "All batches, including the final completion batch, were accepted by RingMaster."
          },
          "401": {
            "description": "Invalid callback secret."
          },
          "503": {
            "description": "Unable to finish delivery. Do not claim completion; existing last-success time is retained."
          }
        }
      }
    }
  }
