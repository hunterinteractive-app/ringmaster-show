    "/v1/connections/refresh": {
      "post": {
        "operationId": "refreshConnection",
        "summary": "Rotate access and refresh credentials",
        "description": "Implemented on the production endpoint. Supply the refresh token in the JSON body; no RingMaster login session or access-token Authorization header is required. Request size limit is 1 MiB. Refresh before expires_at (for example, five minutes early). Serialize renewal per connection across all workers. On HTTP 200, atomically save token, refresh_token, expires_at, refresh_expires_at, and connection_id in encrypted server-side storage before releasing the lock or resuming synchronization. The old access token stops working immediately. A used refresh token cannot be retried: replay revokes its credential generation. Do not blindly retry an uncertain refresh after a timeout, lost response, or storage failure. Pause synchronization and resolve credential state; reauthorize if the replacement cannot be recovered. On HTTP 401, stop renewal and request user reauthorization. Never log or share tokens or collect RingMaster passwords or session JWTs.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              },
              "example": {
                "refresh_token": "rmhmr_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Both credentials rotated; old access invalidated. Persist replacements atomically.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                },
                "example": {
                  "connection_id": "00000000-0000-4000-8000-000000000001",
                  "token": "rmhm_BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
                  "token_type": "Bearer",
                  "expires_at": "2026-10-15T01:00:00Z",
                  "refresh_token": "rmhmr_CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC",
                  "refresh_expires_at": "2027-04-13T00:00:00Z",
                  "scopes": [
                    "animals:write",
                    "results:read",
                    "reports:read"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked or reused refresh token. error.code is invalid_refresh_token or refresh_token_reused. Stop renewal and reauthorize; reuse revokes the matching credential generation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporary upstream failure. Preserve credentials and pause synchronization; do not blindly replay an uncertain refresh.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/animals/existing": {
      "get": {
        "summary": "List authorized existing Show animals for match review",
        "description": "Requires existing-animal read consent. Legacy credentials return 403 consent_required. Up to 500 minimal rows in UUID order; can_link=false means already linked. Owner confirmation happens in Show.",
        "security": [
          {
            "ConnectionToken": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "data containing ringmaster_animal_id, name, tattoo, species, breed, variety, sex, dob, can_link; next_after cursor or null"
          },
          "403": {
            "description": "consent_required; reauthorize with existing-animal read permission"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "RingMasterUser": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Verified signed-in RingMaster user. Never share this session with HerdMaster."
      },
      "ConnectionToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque rmhm_ access token. New tokens expire one hour after issuance or refresh. Legacy tokens retain their original expiration; use expires_at as authoritative."
      },
      "RefreshCallbackSecret": {
        "type": "http",
        "scheme": "bearer",
        "description": "Separate server-to-server secret agreed with HerdMaster for the configured HTTPS callback. This is not a RingMaster user session, Supabase service key, or exhibitor connection token."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "ConnectionRequest": {
        "type": "object",
        "required": [
          "herdmaster_account_id",
          "consent"
        ],
        "properties": {
          "herdmaster_account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "consent": {
            "const": true
          }
        }
      },
      "Connection": {
        "type": "object",
        "required": [
          "connection_id",
          "token",
          "token_type",
          "expires_at",
          "scopes",
          "refresh_token",
          "refresh_expires_at"
        ],
        "properties": {
          "connection_id": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string",
            "pattern": "^rmhm_[A-Za-z0-9_-]{43}$",
            "description": "Access token; replaced by every successful refresh."
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Access expiry; one hour after new issuance or successful refresh."
          },
          "scopes": {
            "type": "array",
            "items": {
              "enum": [
                "animals:write",
                "results:read",
                "reports:read"
              ]
            }
          },
          "refresh_token": {
            "type": "string",
            "pattern": "^rmhmr_[A-Za-z0-9_-]{43}$",
            "description": "Single-use refresh credential, replaced after every successful renewal. Replaying a used credential revokes the matching credential generation."
          },
          "refresh_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Refresh expiry; 180 days after issuance or the most recent successful renewal."
          }
        },
        "description": "Credentials returned at authorization or successful refresh; returned tokens must be saved securely. Refresh before expires_at (for example, five minutes early). Serialize renewal per connection across all workers. On HTTP 200, atomically save token, refresh_token, expires_at, refresh_expires_at, and connection_id in encrypted server-side storage before releasing the lock or resuming synchronization. The old access token stops working immediately. A used refresh token cannot be retried: replay revokes its credential generation. Do not blindly retry an uncertain refresh after a timeout, lost response, or storage failure. Pause synchronization and resolve credential state; reauthorize if the replacement cannot be recovered. On HTTP 401, stop renewal and request user reauthorization. Never log or share tokens or collect RingMaster passwords or session JWTs."
      },
      "InactiveAnimal": {
        "type": "object",
        "required": [
          "id",
          "active",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "active": {
            "const": false
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActiveAnimal": {
        "type": "object",
        "required": [
          "id",
          "active",
          "updated_at",
          "species",
          "tattoo",
          "breed",
          "sex"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "active": {
            "const": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "species": {
            "enum": [
              "rabbit",
              "cavy"
            ]
          },
          "tattoo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "breed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sex": {
            "enum": [
              "Buck",
              "Doe",
              "Boar",
              "Sow"
            ]
          },
          "dob": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "ringmaster_animal_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "variety": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "pattern": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "species": {
                  "const": "rabbit"
                }
              }
            },
            "then": {
              "properties": {
                "sex": {
                  "enum": [
                    "Buck",
                    "Doe"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "sex": {
                  "enum": [
                    "Boar",
                    "Sow"
                  ]
                }
              }
            }
          }
        ]
      },
      "AnimalBatch": {
        "type": "object",
        "required": [
          "animals"
        ],
        "properties": {
          "animals": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ActiveAnimal"
                },
                {
                  "$ref": "#/components/schemas/InactiveAnimal"
                }
              ]
            }
          },
          "refresh_request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional manual-refresh request ID received in RingMaster callback. When present, refresh_complete is also required. Available after the agreed manual-refresh rollout."
          },
          "refresh_complete": {
            "type": "boolean",
            "description": "Use false for intermediate refresh batches and true only on the final batch. Both metadata fields must be omitted for ordinary animal pushes. An empty final animals array is allowed."
          }
        },
        "example": {
          "animals": [
            {
              "id": "HM-12345",
              "active": true,
              "updated_at": "2026-10-12T14:00:00Z",
              "species": "rabbit",
              "tattoo": "ZH24",
              "breed": "Mini Rex",
              "variety": "Black",
              "sex": "Buck",
              "dob": "2026-03-15",
              "name": "Midnight"
            }
          ]
        },
        "dependentRequired": {
          "refresh_request_id": [
            "refresh_complete"
          ],
          "refresh_complete": [
            "refresh_request_id"
          ]
        }
      },
      "ApplyResponse": {
        "type": "object",
        "required": [
          "applied",
          "ignored"
        ],
        "properties": {
          "applied": {
            "type": "integer",
            "minimum": 0
          },
          "ignored": {
            "type": "integer",
            "minimum": 0
          },
          "pending_reviews": {
            "type": "integer",
            "minimum": 0,
            "description": "Unresolved records for this connection. Held records are not imported."
          }
        }
      },
      "CatalogBreed": {
        "type": "object",
        "required": [
          "breed_id",
          "breed",
          "species",
          "variety_mode"
        ],
        "properties": {
          "breed_id": {
            "type": "string",
            "format": "uuid"
          },
          "breed": {
            "type": "string"
          },
          "species": {
            "enum": [
              "rabbit",
              "cavy"
            ]
          },
          "variety_mode": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "entry_id",
