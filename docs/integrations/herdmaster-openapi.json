{
  "openapi": "3.1.0",
  "info": {
    "title": "RingMaster HerdMaster Partner API",
    "version": "1.3.0",
    "description": "Live RingMaster partner API with rotating refresh credentials. New or reauthorized connections receive one-hour access tokens and refresh tokens with a rolling 180-day expiry. HerdMaster must implement automatic renewal and secure atomic credential storage. Initial authorization requires explicit user consent and a verified RingMaster account; no OAuth or automatic account-linking flow is supplied. Full scans pick up result corrections. Manual animal refresh is a staged extension: the RingMaster control and completion protocol require rollout, and HerdMaster must provide the authenticated callback described in webhooks. Existing animal push and token refresh are already deployed. Animal match confirmation is implemented in Show. Possible matches are queued, not applied; POST /v1/animals returns pending_reviews. Existing-animal listing requires new explicit animals:read consent; legacy connections must reauthorize. See animal-match-confirmation.md for deployment status and the implemented protocol."
  },
  "servers": [
    {
      "url": "https://yzjoycrvqkyfrksmaixf.supabase.co/functions/v1/herdmaster-api",
      "description": "RingMaster Show production. Partner credentials issued after user authorization."
    }
  ],
  "paths": {
    "/v1/connections": {
      "post": {
        "summary": "Authorize or rotate a connection with explicit user consent",
        "security": [
          {
            "RingMasterUser": []
          }
        ],
        "responses": {
          "201": {
            "description": "Issued access and refresh credentials; save the entire replacement credential record securely.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "401": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionRequest"
              }
            }
          }
        },
        "description": "Create or reauthorize with explicit consent. Reauthorization replaces both credentials and changes their generation while preserving animal links. Do not blindly retry uncertain creation responses. Existing legacy connections are not modified by deployment; reauthorize once to obtain refresh credentials. Refresh before expires_at (for example, five minutes early). Serialize renewal per connection across all workers. On HTTP 200, atomically save token, refresh_token, expires_at, refresh_expires_at, and connection_id in encrypted server-side storage before releasing the lock or resuming synchronization. The old access token stops working immediately. A used refresh token cannot be retried: replay revokes its credential generation. Do not blindly retry an uncertain refresh after a timeout, lost response, or storage failure. Pause synchronization and resolve credential state; reauthorize if the replacement cannot be recovered. On HTTP 401, stop renewal and request user reauthorization. Never log or share tokens or collect RingMaster passwords or session JWTs."
      }
    },
    "/v1/connections/{connection_id}": {
      "delete": {
        "summary": "Revoke an owned connection",
        "security": [
          {
            "RingMasterUser": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revoked": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "connection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Disconnection immediately revokes access and clears refresh credentials, preventing renewal while preserving animal links."
      }
    },
